{
  "name": "caresync",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx kill-port 2000 && nodemon --signal SIGKILL --ext ts --exec tsx src/server.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "firestore:schema": "tsx src/scripts/generate-firestore-schema.ts",
    "quantix:seed:dart": "tsx src/scripts/generate-quantix-dart-seed.ts",
    "placard:test": "tsx src/scripts/generate-opinion-placard.ts",
    "auth:youtube": "tsx src/scripts/youtube-auth.ts",
    "auth:linkedin-urn": "tsx src/scripts/linkedin-urn.ts",
    "build": "npm run clean && tsc && npm exec tsc-alias",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ci": "vitest --run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@google/genai": "1.50.1",
    "@google/generative-ai": "^0.24.1",
    "@remotion/bundler": "^4.0.459",
    "@remotion/cli": "^4.0.459",
    "@remotion/google-fonts": "^4.0.459",
    "@remotion/media-utils": "^4.0.459",
    "@remotion/renderer": "^4.0.459",
    "@sendgrid/mail": "^8.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express-session": "^1.18.2",
    "@types/fs-extra": "^11.0.4",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.3",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "firebase-admin": "^13.10.0",
    "flutterwave-node-v3": "^1.3.1",
    "fs-extra": "^11.3.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "jose": "^6.1.2",
    "lru-cache": "^11.3.5",
    "mongoose": "^9.6.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "music-metadata": "^11.12.3",
    "node-cron": "^4.2.1",
    "openai": "^6.36.0",
    "path": "^0.12.7",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "redis": "^5.11.0",
    "remotion": "^4.0.459",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "6.2.8",
